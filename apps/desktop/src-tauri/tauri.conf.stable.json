{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitschnitt",
  "mainBinaryName": "mitschnitt",
  "identifier": "media.zickert.mitschnitt.stable",
  "bundle": {
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.icns",
      "icons/stable/icon.ico"
    ],
    "linux": {
      "deb": {
        "provides": [
          "char"
        ],
        "conflicts": [
          "char"
        ],
        "replaces": [
          "char"
        ]
      }
    },
    "macOS": {
      "files": {
        "Resources/AppIcon.icns": "icons/stable/icon.icns"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mitschnitt"
        ]
      }
    },
    "updater": {
      "active": false,
      "endpoints": []
    }
  }
}
